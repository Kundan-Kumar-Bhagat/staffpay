PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/staffpay
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
CLIENT_URL=http://localhost:5173
SEED_DEMO=true
NODE_ENV=development

# Email (reset codes + payslip/invoice delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=StaffPay

# Payroll automation (06:00 on the 1st of each month)
AUTO_PAYROLL=true

# WhatsApp Business (Meta Cloud API)
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=staffpay_alert
WA_NOTIFY=true

# Monday manager digest email (07:30 every Monday)
DIGEST=true